{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gcal",
  "version": "0.1.0",
  "identifier": "com.aleks.beketov.gcal",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "gcal — Calendar",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
